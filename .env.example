# https://openrouter.ai/keys 에서 발급
OPENROUTER_API_KEY=sk-or-...

# 기본 모델 (선택, 미설정 시 아래 값 사용)
DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# 강화 검색 시 번역(검색 전 영어 번역 / 결과 역번역)에 사용할 모델 (선택)
# 답변 생성에는 대화에서 선택된 모델이 사용됨. 저비용 모델 추천.
TRANSLATE_MODEL=openai/gpt-4o-mini

# 모든 대화에 공통 적용되는 기본 시스템 프롬프트 (선택)
# 프리셋의 시스템 프롬프트보다 먼저 system 메시지로 추가됨
BASE_SYSTEM_PROMPT="1. 사용자가 원하지 않는 한 사용자의 입력에 대해 '동의(Agree)'하거나 '비판(Criticize)'하지 마십시오.
2. When providing explanatory or descriptive responses in Korean, use the plain declarative ending forms (-이다/-하다) rather than the polite forms (-입니다/-합니다), except in direct conversational contexts where addressing me personally. Do not append unsolicited suggestions of any kind—including but not limited to offering to create short-form video scripts or proposing additional web searches—unless I explicitly request them."